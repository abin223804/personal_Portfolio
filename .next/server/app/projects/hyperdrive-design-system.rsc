1a:["$","div",null,{"className":"bg-obsidian-surface border border-obsidian-border rounded-2xl p-6 sm:p-10 shadow-2xl space-y-8 font-sans text-titanium leading-relaxed","children":[["$","div",null,{"className":"space-y-3","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-ivory font-mono border-b border-obsidian-border pb-3","children":"Architectural Overview & System Boundaries"}],["$","p",null,{"className":"text-sm leading-relaxed","children":"A modular design system library backed by automated visual regression tests in CI/CD. Coupled with Webpack Module Federation, product teams publish independent micro-frontends into a master host shell without requiring full system rebuilds."}]]}],["$","div",null,{"className":"space-y-4","children":[["$","h3",null,{"className":"text-lg font-bold text-ivory font-mono","children":"Core Engineering Challenges"}],["$","div",null,{"className":"space-y-2","children":[["$","div","0",{"className":"p-3.5 rounded-xl bg-obsidian-card border border-obsidian-border text-xs text-ivory flex items-start gap-3","children":[["$","span",null,{"className":"w-5 h-5 rounded-full bg-copper/20 text-copper flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5","children":1}],["$","span",null,{"children":"Eliminating CSS class collisions across legacy and modern React applications."}]]}],["$","div","1",{"className":"p-3.5 rounded-xl bg-obsidian-card border border-obsidian-border text-xs text-ivory flex items-start gap-3","children":[["$","span",null,{"className":"w-5 h-5 rounded-full bg-copper/20 text-copper flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5","children":2}],["$","span",null,{"children":"Enforcing strict WCAG 2.2 AA accessibility standards across all dynamic components."}]]}],["$","div","2",{"className":"p-3.5 rounded-xl bg-obsidian-card border border-obsidian-border text-xs text-ivory flex items-start gap-3","children":[["$","span",null,{"className":"w-5 h-5 rounded-full bg-copper/20 text-copper flex items-center justify-center font-mono text-[10px] shrink-0 mt-0.5","children":3}],["$","span",null,{"children":"Ensuring seamless state synchronization across independently deployed micro-frontends."}]]}]]}]]}],["$","div",null,{"className":"space-y-4","children":[["$","h3",null,{"className":"text-lg font-bold text-ivory font-mono","children":"Critical Architectural Decisions & Trade-Offs"}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-4","children":[["$","div","Strict CSS Variable Tokens with Dark/Light Engine",{"className":"p-5 rounded-xl bg-obsidian-card border border-obsidian-border space-y-3","children":[["$","h4",null,{"className":"font-mono text-xs font-bold text-copper","children":"Strict CSS Variable Tokens with Dark/Light Engine"}],["$","p",null,{"className":"text-xs text-titanium","children":"Hardcoded Tailwind utility overrides led to inconsistent brand themes. Centralizing design tokens via CSS custom properties enabled instant sub-millisecond theme switching."}],["$","div",null,{"className":"text-[11px] font-mono text-emerald-400 border-t border-obsidian-border/50 pt-2","children":["Impact: ","Reduced total styling bundle sizes and achieved unified dark/light themes."]}]]}]]}]]}],["$","div",null,{"className":"prose prose-invert max-w-none text-xs sm:text-sm pt-4 border-t border-obsidian-border","children":["$","div",null,{"className":"whitespace-pre-line leading-relaxed","children":"\n### Scaling UI Development Across Teams\nDisparate UI teams were creating duplicated component logic and breaking brand consistency. HyperDrive established a single source of truth for component specs, design tokens, and interaction motion.\n\n### Engineering Excellence\n- **Keyboard Navigation**: 100% accessible via arrow keys, escape controls, and focus locks.\n- **Automated QA**: Every pull request undergoes visual diff checking via Storybook Chromatic and automated E2E testing in Playwright.\n"}]}]]}]
